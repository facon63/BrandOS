{
 "duration": 59.53,
 "fps": 30,
 "segments": [
  {
   "i": 0,
   "text": "Tous les studios vous montrent le sommet.",
   "start": 1.25,
   "end": 3.182
  },
  {
   "i": 1,
   "text": "Le jeu fini.",
   "start": 3.632,
   "end": 4.365
  },
  {
   "i": 2,
   "text": "La bande-annonce parfaite.",
   "start": 4.715,
   "end": 5.939
  },
  {
   "i": 3,
   "text": "Jamais l'ascension.",
   "start": 6.489,
   "end": 7.48
  },
  {
   "i": 4,
   "text": "Altherion,",
   "start": 8.38,
   "end": 8.994
  },
  {
   "i": 5,
   "text": "c'est l'inverse :",
   "start": 9.194,
   "end": 9.885
  },
  {
   "i": 6,
   "text": "un studio de jeux vidéo qui se construit sous vos yeux.",
   "start": 10.185,
   "end": 12.85
  },
  {
   "i": 7,
   "text": "À partir de zéro.",
   "start": 13.2,
   "end": 14.137
  },
  {
   "i": 8,
   "text": "Au départ,",
   "start": 14.887,
   "end": 15.507
  },
  {
   "i": 9,
   "text": "un enfant qui bâtissait des refuges dans Minecraft.",
   "start": 15.707,
   "end": 18.236
  },
  {
   "i": 10,
   "text": "Plus chez lui dans les mondes imaginaires que dans le vrai.",
   "start": 18.536,
   "end": 21.046
  },
  {
   "i": 11,
   "text": "Aujourd'hui,",
   "start": 21.596,
   "end": 22.096
  },
  {
   "i": 12,
   "text": "il construit les siens.",
   "start": 22.346,
   "end": 23.388
  },
  {
   "i": 13,
   "text": "Chaque ligne de code est une prise.",
   "start": 24.388,
   "end": 26.25
  },
  {
   "i": 14,
   "text": "Chaque bug,",
   "start": 26.55,
   "end": 27.226
  },
  {
   "i": 15,
   "text": "une chute.",
   "start": 27.426,
   "end": 28.016
  },
  {
   "i": 16,
   "text": "Et chaque chute devient un épisode.",
   "start": 28.466,
   "end": 30.26
  },
  {
   "i": 17,
   "text": "À ses côtés,",
   "start": 30.96,
   "end": 31.62
  },
  {
   "i": 18,
   "text": "un golem de lumière,",
   "start": 31.82,
   "end": 33.007
  },
  {
   "i": 19,
   "text": "qui grandit à chaque palier.",
   "start": 33.207,
   "end": 34.491
  },
  {
   "i": 20,
   "text": "Une seule règle sur cette montagne :",
   "start": 35.291,
   "end": 37.006
  },
  {
   "i": 21,
   "text": "jamais de jeu bâclé.",
   "start": 37.306,
   "end": 38.497
  },
  {
   "i": 22,
   "text": "Jamais de mécanique pour vider vos poches.",
   "start": 38.797,
   "end": 40.778
  },
  {
   "i": 23,
   "text": "Seulement des jeux qui laissent sans voix.",
   "start": 41.278,
   "end": 43.041
  },
  {
   "i": 24,
   "text": "Six mois.",
   "start": 44.141,
   "end": 44.683
  },
  {
   "i": 25,
   "text": "Deux à trois jeux.",
   "start": 44.983,
   "end": 45.825
  },
  {
   "i": 26,
   "text": "Les vrais chiffres,",
   "start": 46.175,
   "end": 46.976
  },
  {
   "i": 27,
   "text": "les vrais doutes,",
   "start": 47.176,
   "end": 47.848
  },
  {
   "i": 28,
   "text": "les vraies victoires.",
   "start": 48.048,
   "end": 49.006
  },
  {
   "i": 29,
   "text": "L'ascension commence.",
   "start": 49.706,
   "end": 50.776
  },
  {
   "i": 30,
   "text": "Rejoignez l'expédition dès le premier épisode,",
   "start": 51.176,
   "end": 53.591
  },
  {
   "i": 31,
   "text": "sur YouTube et Instagram.",
   "start": 53.791,
   "end": 55.351
  },
  {
   "i": 32,
   "text": "Altherion.",
   "start": 56.051,
   "end": 56.676
  },
  {
   "i": 33,
   "text": "De zéro à studio.",
   "start": 57.026,
   "end": 57.98
  }
 ]
}